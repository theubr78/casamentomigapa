# Copie para .env e preencha.
PORT=3000
NODE_ENV=development

# Painel dos noivos (/admin). Use um texto longo e aleatório, ex.: openssl rand -hex 24
ADMIN_TOKEN=

# Confirmação de presença: depois deste instante o formulário fecha.
# Formato obrigatório: data T hora e fuso (-03:00 = Brasília). "03/05/2027" é recusado.
RSVP_PRAZO=2027-05-03T23:59:59-03:00

# Conteúdo dos noivos (aparece no site)
WHATSAPP_NOIVOS=5573999999999
SPOTIFY_URL=https://open.spotify.com/playlist/XXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_ID=

# Pix da lista de presentes
# PIX_CHAVE: CPF/CNPJ (com ou sem pontos), e-mail, telefone com +55 (ex.: +5573999999999) ou chave aleatória.
# Ao subir, o servidor mostra no log o tipo de chave que reconheceu — confira.
PIX_CHAVE=
PIX_NOME=Millena Exemplo
PIX_CIDADE=Jaguaquara
PIX_BANCO=Nubank
# Texto mostrado em "Recebedor:" (opcional; padrão = PIX_NOME)
PIX_RECEBEDOR_EXIBICAO=

# Lista de presentes: endereço mostrado a quem escolhe "Vou comprar"
ENDERECO_ENTREGA=Rua Exemplo, 123, Bairro, Cidade - BA, CEP 00000-000

# Opcional
# DB_ARQUIVO=./data/casamento.db
# CORS_ORIGIN=https://site-do-frontend.com.br

# TRUST_PROXY: quantos proxies existem na frente do site.
#   Render, Railway, Fly.io, Nginx na frente → 1   ·   acesso direto (sem proxy) → deixe vazio
#   Errado para menos: todos os convidados contam como o mesmo IP e o limite bloqueia todo mundo.
#   Errado para mais: qualquer um forja o IP e burla o limite. "true" é recusado.
# TRUST_PROXY=1
